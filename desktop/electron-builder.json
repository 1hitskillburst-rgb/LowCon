{
  "appId": "com.lowcon.workbench",
  "productName": "LowCon",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "desktop/**/*",
    "public/icon.svg",
    "package.json",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "desktop/main.cjs"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis", "portable"]
  },
  "linux": {
    "category": "Development",
    "target": ["AppImage", "tar.gz"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
