{
  "appId": "com.lowcon.workbench",
  "productName": "LowCon",
  "directories": {
    "output": "release",
    "buildResources": "desktop/build"
  },
  "files": [
    "dist/**/*",
    "desktop/**/*",
    "public/icon.svg",
    "package.json",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "desktop/main.cjs"
  },
  "mac": {
    "icon": "desktop/build/icon.png",
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"]
  },
  "win": {
    "icon": "desktop/build/icon.ico",
    "target": ["nsis", "portable"]
  },
  "linux": {
    "icon": "desktop/build/icon.png",
    "category": "Development",
    "target": ["AppImage", "tar.gz"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "desktop/build/icon.ico",
    "uninstallerIcon": "desktop/build/icon.ico",
    "installerHeaderIcon": "desktop/build/icon.ico"
  }
}
