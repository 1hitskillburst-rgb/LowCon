{
  "name": "lowcon",
  "private": true,
  "version": "1.0.0",
  "description": "Private, budget-first local AI model workbench for web and desktop",
  "author": "LowCon",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "desktop:dev": "LOWCON_DESKTOP_DEV=1 electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --config desktop/electron-builder.json --dir",
    "desktop:build": "npm run build && electron-builder --config desktop/electron-builder.json",
    "lint": "eslint src server server.ts --ext .ts,.tsx",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  }
}
